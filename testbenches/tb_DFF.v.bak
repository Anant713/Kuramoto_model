`timescale 1ns/1ps

module tb_D_ff;
    reg D;
    reg clk;
    wire Q;
    wire Q_bar;

    // Instantiate the DUT (Device Under Test)
    D_ff uut (
        .D(D),
        .clk(clk),
        .Q(Q),
        .Q_bar(Q_bar)
    );

    // Clock generation: toggles every 5 ns -> 10 ns period (100 MHz)
    initial clk = 0;
    always #5 clk = ~clk;

    // Stimulus generation
    initial begin
        $display("Time\tclk\tD\tQ\tQ_bar");
        $monitor("%0t\t%b\t%b\t%b\t%b", $time, clk, D, Q, Q_bar);
    success = 1;
        D = 0;

        for (i = 0; i < 5; i = i + 1) begin
            D = D_seq[i];
            #10;
            // Check if Q matches previous D (because DFF captures on posedge)
            if (Q !== D_seq[i-1] && i > 0) begin
                $display("Mismatch at step %0d: Q=%b expected %b", i, Q, D_seq[i-1]);
                success = 0;
            end
            // Check Q_bar
            if (Q_bar !== ~D_seq[i-1] && i > 0) begin
                $display("Mismatch at step %0d: Q_bar=%b expected %b", i, Q_bar, ~D_seq[i-1]);
                success = 0;
            end
        end

        if (success)
            $display("TEST PASSED: All outputs matched expected values!");
        else
            $display("TEST FAILED: See mismatches above.");

        #10 $finish;
    end
endmodule
